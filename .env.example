# ==============================================================================
# ORION Autonomous AI Workforce — Environment Configuration Example
# Copy this file to .env and configure values before starting in production.
# NEVER commit .env or actual production credentials to version control.
# ==============================================================================

# Runtime Environment (production | development | testing)
ORION_ENV=production

# Network Binding
# Use 0.0.0.0 when deploying inside Docker, Railway, Render, Fly.io, or VPS.
# Use 127.0.0.1 for local loopback development.
ORION_HOST=0.0.0.0
ORION_PORT=8000

# Workspace Root
# Path to the isolated target repository/workspace that agents may inspect and modify.
# Must be an absolute path in production.
ORION_WORKSPACE=/workspace

# Security: API Authentication Token
# Required when binding to a non-loopback address (0.0.0.0) in production.
# Generate a cryptographically secure random token (e.g. openssl rand -hex 32).
ORION_API_TOKEN=your_secure_random_api_token_here

# Security: Production CORS Allowed Origins
# Comma-separated list of allowed frontend origins (e.g. your Vercel deployment URL).
# Supports explicit domains and wildcard patterns (e.g. https://*.vercel.app).
ORION_CORS_ALLOWED_ORIGINS=https://your-orion-deployment.vercel.app,http://localhost:3000

# Rate Limiting Controls
ORION_RATE_LIMIT_ENABLED=true
ORION_RATE_LIMIT_PER_MINUTE=600
ORION_MISSION_RATE_LIMIT_PER_MINUTE=20

# Epistemic & Security Redaction
# Redacts high-entropy keys, passwords, and environment credentials from diffs and logs.
ORION_REDACTION_ENABLED=true

# Persistent Mission State Directory
# Directory where mission state JSON and evidence ledger records are persisted.
ORION_DATA_DIR=/workspace/.orion_state

# ==============================================================================
# Frontend Environment Variables (Set in Vercel Project Settings)
# ==============================================================================

# Target Backend URL for Vercel Static Frontend Deployment
# When deploying the static frontend to Vercel, set this variable to point to
# your hosted container backend (e.g. Railway, Render, Fly.io, VPS, Cloud Run).
# If left empty, the frontend will default to same-origin / relative (/api/...).
ORION_API_URL=https://your-orion-backend.up.railway.app
